<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Evelyn Template</title>
    <link href="https://fonts.googleapis.com/css?family=Lato:400,400i|PT+Serif:700" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
    <script src="https://unpkg.com/scrollreveal@4.0.0/dist/scrollreveal.min.js"></script>
</head>
<body class="is-boxed has-animations">
    <div class="body-wrap boxed-container">
        <header class="site-header">
            <div class="container">
                <div class="site-header-inner">
                    <div class="brand header-brand">
                        <h1 class="m-0">
                            <a href="#">
                                <svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                                    <title>Evelyn</title>
                                    <defs>
                                        <radialGradient cy="0%" fx="50%" fy="0%" r="100%" id="logo-gradient">
                                            <stop stop-color="#FFF" offset="0%"/>
                                            <stop stop-color="#FFF" stop-opacity=".24" offset="100%"/>
                                        </radialGradient>
                                    </defs>
                                    <path d="M16 32C7.163 32 0 24.837 0 16S7.163 0 16 0s16 7.163 16 16-7.163 16-16 16zm0-10a6 6 0 1 0 0-12 6 6 0 0 0 0 12z" fill="url(#logo-gradient)" fill-rule="evenodd"/>
                                </svg>
                            </a>
                        </h1>
                    </div>
                </div>
            </div>
        </header>

        <main>
            <section class="hero text-light text-center">
                <div class="container-sm">
                    <div class="hero-inner">
                        <h1 class="hero-title h2-mobile mt-0 is-revealing"></h1>
                        <p class="hero-paragraph is-revealing">
                        <label class="input-label"><strong>Generate your QR code</strong>  </label></p><br/>
                        <input type="text" class="input-field"  id="input" placeholder="Enter text, URL, phone, or email to generate QR code" size="45"/>
                        <p class="hero-cta is-revealing"><a class="button button-secondary button-shadow" onclick="togglevariable()">Create QR</a></p>
                        <script>
                          let QrData;
                          async function hello(){
  const value= document.getElementById("Email").value.trim();
  try {
    if (!value) {
      document.getElementById("hero").innerText = "mail not sent";
      return;
    }
  const result= await fetch("/api/v1/mailer",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({value,QrData})
  }) 

  let datas;
if (result.ok) {
  //Read JSON if response was successful
  datas = await result.json();
  alert("QR is mail to your email");
} else {
  //  Read text if error (can't use .json())
  const errorText = await result.text();
  console.error("Server error:", errorText);
  // Optionally display this on the page
  document.getElementById("hero").innerText = "Mail not sent. Server error occurred.";
}
console.log(datas);
  }
    catch(err){
      console.log(err)
    }
}
const togglevariable = async () => {
  try {
    const data = document.getElementById("input").value.trim();
    if (!data) {
      document.getElementById("hero").innerText = "QR not generated.";
      return;
    }
   
    const divMedia = document.createElement("div");
    divMedia.className = "hero-media";
    divMedia.id = "heroo";

    // for mailing the qr code to email
    const mailQR = document.createElement("div");
    mailQR.className = "input-group";
    mailQR.innerHTML = `
   <input type="email" class="input-y" id="Email" name="Email" placeholder="enter your email" autocomplete="off">
     <input class="button--submit" value="Mail to your email" type="button" onClick="hello()">
                      
        
      `;



    const response = await fetch("/api/v1/qr", {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: data })
    });

     QrData = await response.json(); 
    console.log(QrData);
       document.getElementById("hero").innerHTML="";
    if (QrData.qr) {
      divMedia.innerHTML = `<h1>
        your QrCode</h1>
        <img src="${QrData.qr}" alt="QR Code" style="width: 300px; height: 300px; " />
      `;
    } else {
      divMedia.innerHTML = `<p>QR not generated.</p>`;
    }

    document.getElementById("hero").appendChild(divMedia);
    document.getElementById("hero").appendChild(mailQR);

  } catch (err) {
    console.error('Error generating QR:', err);
    document.getElementById("hero").innerText = "An error occurred.";
  }
};

                        </script>
                        
                         <div id="hero">
                       
                         </div>
                    </div>
                </div>
            </section>
            

      

         
        </main>


    </div>
    <script src="js/main.min.js"></script>
</body>
</html>
